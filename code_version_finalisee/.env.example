# =====================================================================================
# Configuration du Copilote RUN.
# Copier ce fichier en « .env » puis le compléter :   cp .env.example .env
# Le fichier .env contient des secrets : il est ignoré par Git, ne le partagez pas.
# Sans aucune modification, l'application démarre en mode démonstration, sans LLM.
# =====================================================================================

# ---- Source des tickets : demo | jira | fichier -------------------------------------
SOURCE=demo

# Mode « demo » : le jeu de tickets synthétiques (aucun identifiant nécessaire).
DEMO_TICKETS=../tma-data/data/tickets.json

# Mode « fichier » : un fichier JSON (format de l'API Jira) ou CSV avec en-tête.
FICHIER_TICKETS=data/mes_tickets.json

# Mode « jira » : API REST Jira Cloud, en LECTURE SEULE (requêtes GET uniquement).
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJET=TMA
# Facultatif : remplacer la requête par défaut (tout le projet).
JIRA_JQL=
JIRA_MAX_TICKETS=5000

# ---- LLM du copilote (facultatif) ----------------------------------------------------
# Laisser vide pour désactiver le chat : tout le reste fonctionne.
# Azure OpenAI (passerelle fournie par Sopra Steria). Donner la racine de la passerelle ;
# un suffixe « /openai/v1/ » est toléré et retiré automatiquement.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
AZURE_OPENAI_API_VERSION=2024-02-01

# Variante : une API compatible OpenAI. Utilisée seulement si AZURE_OPENAI_ENDPOINT est vide.
#   - passerelle de type « .../openai/v1/ » dont la clé passe aussi dans l'adresse :
# LLM_BASE_URL=https://<passerelle>/openai/v1/
# LLM_API_KEY=<clé>
# LLM_MODEL=gpt-6-luna
# LLM_PARAMETRE_CLE=subscription-key
#   - ou Ollama en local :
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

LLM_MAX_TOURS=8
LLM_REASONING_EFFORT=none

# ---- Divers --------------------------------------------------------------------------
# Dossier de la base SQLite et du cache des embeddings.
DOSSIER_DONNEES=data
# Préfixes des identifiants pseudonymisés à retirer des textes (CLI-1234, DOS-12345).
IDENTIFIANTS_A_RETIRER=CLI,DOS
